data/*
!data/.gitkeep

# Experiment outputs, generated results, saved weights, and plots
results/*.csv
results/plots/*
!results/plots/.gitkeep
results/saved_models/*
!results/saved_models/.gitkeep
results/shap/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Unit test & coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Logs
*.log

# IDE & Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

